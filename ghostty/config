progress-style = true

#theme = Aura
# theme = Ayu
theme = Aura


#adds tabs to the gtk titlebar, instead of below
# gtk-titlebar = true
gtk-titlebar-style = tabs

background = 09090d
# background-blur = true
background-opacity = 0.95

# font-family = "Hasklug Nerd Font"
font-family = "MartianMono Nerd Font Mono"
font-size = 11.25
adjust-cell-height = 4

#### Multiplexing keybindings
# the > is used to combine keys. creating the leader
keybind = ctrl+a>v=new_split:right
keybind = ctrl+a>h=new_split:down

keybind = unconsumed:ctrl+h=goto_split:left
keybind = unconsumed:ctrl+j=goto_split:bottom
keybind = unconsumed:ctrl+k=goto_split:top
keybind = unconsumed:ctrl+l=goto_split:right

keybind = alt+shift+h=previous_tab
keybind = alt+shift+l=next_tab

keybind = unconsumed:ctrl+shift+h=resize_split:left,10
keybind = unconsumed:ctrl+shift+j=resize_split:down,10
keybind = unconsumed:ctrl+shift+k=resize_split:up,10
keybind = unconsumed:ctrl+shift+l=resize_split:right,10

##### cursor shaders
# custom-shader = shaders/cursor_smear_custom.glsl
# custom-shader = shaders/cursor_smear.glsl
# custom-shader = shaders/glow.glsl
custom-shader = shaders/cursor_glide.glsl

